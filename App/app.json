{
  "expo": {
    "name": "PetgramApp",
    "slug": "PetgramApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O PetGram usa suas fotos para criar publicações e capas de comunidades.",
          "cameraPermission": "O PetGram usa a câmera para fotografar seu pet."
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    }
  }
}